#pragma kernel GrayscaleCS
#pragma kernel GrayscaleCSArray

Texture2D<float4> _SourceTex;
RWTexture2D<float4> _ResultTex;
Texture2DArray<float4> _SourceArray;
RWTexture2DArray<float4> _ResultArray;
float _Blend;
float4 _TextureSize;

float4 Grayscale(float4 color)
{
    float luminance = dot(color.rgb, float3(0.2126729, 0.7151522, 0.0721750));
    color.rgb = lerp(color.rgb, luminance.xxx, _Blend);
    // Keep linear HDR values. The render target/output pipeline owns color encoding.
    return color;
}

[numthreads(8, 8, 1)]
void GrayscaleCS(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    _ResultTex.GetDimensions(width, height);
    if (id.x >= width || id.y >= height || any(id.xy >= (uint2)_TextureSize.xy)) return;
    _ResultTex[id.xy] = Grayscale(_SourceTex.Load(int3(id.xy, 0)));
}

[numthreads(8, 8, 1)]
void GrayscaleCSArray(uint3 id : SV_DispatchThreadID)
{
    uint width, height, slices;
    _ResultArray.GetDimensions(width, height, slices);
    if (id.x >= width || id.y >= height || id.z >= slices || any(id >= (uint3)_TextureSize.xyz)) return;
    _ResultArray[id] = Grayscale(_SourceArray.Load(int4(id, 0)));
}
